app.use("/customer/auth", function auth(req,res,next){if(req.session.authorization){let token=req.session.authorization['accessToken'];const jwt=require('jsonwebtoken');jwt.verify(token,"access",(err,user)==user;next();}else{return res.status(403).json({message:"User not authenticated"})}});}else{return res.status(403).json({message:"User not logged in"})}});
